# Copy this file to a new file named .env and fill in your own values.
# The .env file stays on your computer (it is not uploaded to GitHub).
DB_HOST=localhost
DB_USER=<workbench username>
DB_PASS=<workbench password>
DB_NAME=library
# Optional: only if your MySQL does not use the usual port 3306 (for example 3307).
# DB_PORT=3306

# Required. Any long random text; it signs the login cookies. The app will not start without it.
SESSION_SECRET=<any long random string>

# The port the app listens on. Leave it out to use 3000. Azure sets this itself.
PORT=3000

# Only for the hosted database on Azure: turns on the encrypted connection it requires.
# Leave it out on your own computer.
# DB_SSL=true
